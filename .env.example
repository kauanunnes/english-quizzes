# Segunda Tela — variáveis de ambiente (docs/13 §13.2)
# Copie para .env.local e preencha. Valor vazio conta como "não definido".
# O servidor não sobe se faltar uma variável obrigatória para o ambiente (src/instrumentation.ts).
# Gerar segredos: openssl rand -base64 32

# ---------------------------------------------------------------------------
# Modo local rápido (sem nenhuma chave): MOCK_UPSTREAMS=1 usa dados sintéticos
# da TMDB e da OpenSubtitles; com LLM_PROVIDER=fake, nada externo é chamado.
# ---------------------------------------------------------------------------
MOCK_UPSTREAMS=

# --- App ---------------------------------------------------------------------
# Obrigatória em produção: origem pública do app (checagem de Origin)
APP_ORIGIN=
# Opcional: versão exibida em /api/health e nos logs (padrão: VERCEL_GIT_COMMIT_SHA)
APP_VERSION=
# Opcional: debug | info | warn | error (padrão: debug fora de produção, info em produção)
LOG_LEVEL=

# --- Banco (Neon) --------------------------------------------------------------
# Vazio ou pglite://memory = Postgres em memória (PGlite), com as mesmas migrações.
# Obrigatória em produção: conexão "pooled" do Neon.
DATABASE_URL=
# Conexão direta do Neon, usada por pnpm db:migrate e pnpm build:vercel
DATABASE_URL_UNPOOLED=

# --- TMDB ----------------------------------------------------------------------
# Obrigatória, a não ser com MOCK_UPSTREAMS=1.
# Use o "API Read Access Token" (longo, começa com eyJ), não a "API Key" curta.
TMDB_READ_TOKEN=

# --- OpenSubtitles -------------------------------------------------------------
# mock (padrão: local e preview, não gasta cota) | live (produção)
OS_MODE=mock
# Obrigatórias com OS_MODE=live
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
OPENSUBTITLES_USER_AGENT=SegundaTela v0.1.0
# Downloads do dia reservados para uso interativo (§4.2.10)
OS_INTERACTIVE_RESERVE=5
# Fallback SubDL (§4.2.11): desligado até ler os termos
SUBDL_ENABLED=false
SUBDL_API_KEY=

# --- LLM (§4.3.9) --------------------------------------------------------------
# fake (padrão local e testes) | anthropic
LLM_PROVIDER=fake
# Obrigatória com LLM_PROVIDER=anthropic. Use uma chave diferente da de produção.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_EFFORT=medium
LLM_THINKING=adaptive
LLM_MAX_TOKENS_PER_SEGMENT=8000
LLM_MAX_CONCURRENCY=4
LLM_TIMEOUT_MS=120000
LLM_PRICE_IN_PER_MTOK=2
LLM_PRICE_OUT_PER_MTOK=10
LLM_PRICE_CACHE_READ_PER_MTOK=0.10
LLM_DAILY_BUDGET_USD=1.00
QUIZ_INCLUDE_PT_EXPLANATION=true

# --- Segurança e limites (ADR-006) ---------------------------------------------
# Obrigatórias em produção. As três primeiras: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
ADMIN_TOKEN=
IP_HASH_SALT=
# Frase longa. Fora de produção, sem ela vale o código de desenvolvimento "segunda-tela-2026".
GENERATION_ACCESS_CODE=
# 25 em produção, 3 no preview
DAILY_GENERATION_LIMIT=25

# --- Funcionalidades -------------------------------------------------------------
FEATURE_UPLOAD=false
FEATURE_REPORTS=true
SEGMENT_TARGET_MIN=5

# --- Observabilidade (opcional, §13.8) ------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Só na Fase 1 (tracer bullet) -----------------------------------------------
# Vazio: /tracer usa Victorious S01E04 (TMDB 31251, temporada 1, episódio 4)
TRACER_ONLY=false
TRACER_SERIES_ID=
TRACER_SEASON=
TRACER_EPISODE=
